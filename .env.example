DJANGO_SECRET_KEY=your-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# --- Database (Local MySQL) ---
DB_NAME=thesis_topics
DB_USER=thesis_user
DB_PASSWORD=thesis_user1234
DB_HOST=127.0.0.1
DB_PORT=3307

# --- Database (Production Cloud MySQL via URL - e.g. Aiven, TiDB, Clever Cloud) ---
# DATABASE_URL=mysql://user:password@host:port/database_name

# --- Security / BYOK Encryption ---
# FERNET_KEYS=comma_separated_32_byte_base64_fernet_keys

# --- LLM API Keys ---
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- Active Models ---
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
LLM_PROVIDER=
LLM_FALLBACK_CHAIN=gemini,groq,openrouter

# --- Email (optional) ---
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
